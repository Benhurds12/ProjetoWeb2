# Arquivo de exemplo de variáveis de ambiente.
# Copie para .env e preencha com valores reais. NÃO commite o .env.

# Chave secreta usada para assinar os tokens JWT.
# Use um valor longo e aleatório em produção. Ex.: openssl rand -base64 32
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# String de conexão com o PostgreSQL.
# Se omitida, a aplicação usa o default de desenvolvimento (localhost).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/projetoweb2?sslmode=disable
