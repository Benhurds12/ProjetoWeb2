  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {"type": "string"}
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {"type": "string"}
        }
      },
      "UserInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {"type": "string", "format": "email"},
          "password": {"type": "string", "format": "password"},
          "name": {"type": "string"}
        }
      },
      "SetorInput": {
        "type": "object",
        "required": ["nome"],
        "properties": {
          "nome": {"type": "string"},
          "descricao": {"type": "string"}
        }
      },
      "BemInput": {
        "type": "object",
        "required": ["nome", "setor_id"],
        "properties": {
          "nome": {"type": "string"},
          "descricao": {"type": "string"},
          "setor_id": {"type": "string"},
          "fornecedor_id": {"type": "string"},
          "fabricante_id": {"type": "string"},
          "numero_serie": {"type": "string"}
        }
      },
      "FornecedorInput": {
        "type": "object",
        "required": ["nome"],
        "properties": {
          "nome": {"type": "string"},
          "cnpj": {"type": "string"},
          "contato": {"type": "string"}
        }
      },
      "FabricanteInput": {
        "type": "object",
        "required": ["nome"],
        "properties": {
          "nome": {"type": "string"},
          "pais": {"type": "string"}
        }
      }
    }
  }
